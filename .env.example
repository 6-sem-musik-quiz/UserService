# Copy this file to .env (it is gitignored) and fill in the values.
# Used by docker-compose.yml. Never commit .env.

# The userservice user's password. Get it with (Tailscale on, OpenBao login):
#   bao kv get -field=userservice kv/quiz/postgres
# or ask Asger. Wrap it in single quotes if it contains $ or #.
DB_PASSWORD=

# Optional. Default is the tailnet host quiz-postgres.tail5a1bc5.ts.net:5432.
# Without Tailscale, run `kubectl -n quiz port-forward svc/postgresql 15432:5432`
# and uncomment these two lines:
# DB_HOST=host.docker.internal
# DB_PORT=15432
